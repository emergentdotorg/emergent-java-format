<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.emergent.javaformat</groupId>
    <artifactId>emergent-java-format-parent</artifactId>
    <version>3.0-SNAPSHOT</version>
  </parent>

  <groupId>com.palantir.javaformat</groupId>
  <artifactId>palantir-java-format-native</artifactId>
  <name>palantir-java-format-native</name>
  <description>Palantir Java Format</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <executions>
          <execution>
            <id>select-jdk-toolchain</id>
            <phase>initialize</phase>
            <goals>
              <goal>select-jdk-toolchain</goal>
            </goals>
            <configuration>
              <version>[23,24)</version>
              <!--<version>[17,18)</version>-->
              <vendor>GraalVM Community</vendor>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
        <groupId>org.graalvm.nativeimage</groupId>
        <artifactId>native-image-maven-plugin</artifactId>
        <version>21.2.0</version>
        -->
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <version>0.11.6-SNAPSHOT</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <id>build-native</id>
            <goals>
              <goal>compile-no-fork</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
        <configuration>
          <imageName>emergent-java-format</imageName>
          <fallback>false</fallback>
          <mainClass>${mainClass}</mainClass>
          <!--<enforceToolchain>true</enforceToolchain>-->
          <configFiles>
            <configFile>${project.basedir}/src/main/resources/META-INF/native-image</configFile>
          </configFiles>
          <jvmArgs>
            <jvmArg>--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</jvmArg>
            <jvmArg>--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</jvmArg>
          </jvmArgs>
          <buildArgs>
            <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
            <buildArg>-H:+IncludeAllLocales</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <buildArg>-H:-UseContainerSupport</buildArg>
            <buildArg>-march=compatibility</buildArg>
            <buildArg>--exact-reachability-metadata</buildArg>
            <buildArg>--initialize-at-build-time=com.sun.tools.javac.file.Locations</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>com.palantir.javaformat</groupId>
      <artifactId>palantir-java-format</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.palantir.javaformat</groupId>
      <artifactId>palantir-java-format-jdk-bootstrap</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.palantir.javaformat</groupId>
      <artifactId>palantir-java-format-spi</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
